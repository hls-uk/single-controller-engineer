{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hls.uk/schemas/sce/knowledge-manifest.schema.json",
  "$comment": "Every bound here mirrors the engine's KnowledgeContract, so a manifest this schema accepts is one controller composition accepts. maxUtf8Bytes and maxCanonicalBytes are non-standard keywords with no draft-2020-12 equivalent: checks/lib.mjs evaluates them and refuses any keyword outside its declared subset, while a generic validator silently ignores them and therefore accepts strictly more. canonicalUnicodeScalar carries a portable pattern sibling that states the same rule. See checks/README.md.",
  "title": "Single-controller knowledge repository manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "projectId",
    "accessDomainId",
    "audience",
    "mode",
    "humanDriver",
    "driveAliases",
    "artifactHomes",
    "frontmatterSchemaPath",
    "boundaryPolicy",
    "verification",
    "provenance",
    "materialisationTargets",
    "minimumVersions"
  ],
  "properties": {
    "schema": { "const": "sce.knowledge-manifest" },
    "version": { "const": 1 },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "accessDomainId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,126}$"
    },
    "audience": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "mode": { "enum": ["legacy", "pilot", "git-first"] },
    "humanDriver": {
      "$comment": "KnowledgeContract.humanDriver is bounded in code units and in UTF-8 bytes; free text makes the two differ.",
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "maxUtf8Bytes": 8192
    },
    "driveAliases": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "markerFile",
          "mountPolicy",
          "mountPathVariable",
          "namespaceControl"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "markerFile": {
            "$comment": "An exact safe basename: no separator, no dot segment, and the leading character the engine's basename grammar allows.",
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "maxUtf8Bytes": 255,
            "pattern": "^(?!\\.\\.?$)[A-Za-z0-9.][A-Za-z0-9._-]*$"
          },
          "mountPolicy": { "enum": ["required", "optional"] },
          "mountPathVariable": { "$ref": "#/$defs/environmentName" },
          "namespaceControl": { "const": "exclusive" }
        }
      }
    },
    "artifactHomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentInstructions",
        "knowledge",
        "events",
        "generated",
        "driveIncoming",
        "driveRendered",
        "credentials",
        "derivedIndexes"
      ],
      "properties": {
        "agentInstructions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "knowledge": { "type": "string", "minLength": 1 },
        "events": { "type": "string", "minLength": 1 },
        "generated": { "type": "string", "minLength": 1 },
        "driveIncoming": { "$ref": "#/$defs/driveHome" },
        "driveRendered": { "$ref": "#/$defs/driveHome" },
        "credentials": { "const": "external" },
        "derivedIndexes": { "const": "rebuildable" }
      }
    },
    "frontmatterSchemaPath": { "type": "string", "minLength": 1 },
    "boundaryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedWriteRoots", "forbiddenPaths", "forbiddenMarkers"],
      "properties": {
        "allowedWriteRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbiddenPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbiddenMarkers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fast", "integration", "release"],
      "properties": {
        "fast": { "$ref": "#/$defs/commands" },
        "integration": { "$ref": "#/$defs/commands" },
        "release": { "$ref": "#/$defs/commands" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventsDirectory",
        "recordFormatVersion",
        "rollupGeneratorCommand",
        "reproducibilityCommand",
        "worktreeRootVariable"
      ],
      "properties": {
        "eventsDirectory": { "type": "string", "minLength": 1 },
        "recordFormatVersion": { "const": 1 },
        "rollupGeneratorCommand": { "$ref": "#/$defs/command" },
        "reproducibilityCommand": { "$ref": "#/$defs/command" },
        "worktreeRootVariable": { "$ref": "#/$defs/environmentName" }
      }
    },
    "materialisationTargets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourcePattern",
          "destinationAlias",
          "destinationSubpath",
          "namingPolicy",
          "sidecarRequired"
        ],
        "properties": {
          "sourcePattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 192,
            "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\*\\*)[A-Za-z0-9][A-Za-z0-9._*?-]*(?:/[A-Za-z0-9][A-Za-z0-9._*?-]*)*$"
          },
          "destinationAlias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "destinationSubpath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 192,
            "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          },
          "namingPolicy": {
            "enum": [
              "source-basename",
              "iso-date-prefix",
              "content-hash-suffix"
            ]
          },
          "sidecarRequired": { "type": "boolean", "const": true }
        }
      }
    },
    "minimumVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "playbook", "profile"],
      "properties": {
        "root": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "playbook": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "profile": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    }
  },
  "$defs": {
    "environmentName": {
      "$comment": "The controller resolves these names at composition; the grammar is the engine's environment-name grammar, which admits a leading underscore and a single character.",
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "maxUtf8Bytes": 160,
      "pattern": "^[A-Z_][A-Z0-9_]{0,159}$"
    },
    "driveHome": {
      "type": "string",
      "minLength": 3,
      "maxLength": 192,
      "maxUtf8Bytes": 192,
      "pattern": "^[a-z][a-z0-9-]{0,62}:[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "maxCanonicalBytes": 8192,
      "items": {
        "$comment": "The pattern is the portable statement of canonicalUnicodeScalar: no NUL and no unpaired surrogate, under both Unicode-mode and code-unit-mode ECMA-262 semantics.",
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "maxUtf8Bytes": 1024,
        "canonicalUnicodeScalar": true,
        "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "maxCanonicalBytes": 32768,
      "items": { "$ref": "#/$defs/command" }
    }
  }
}
